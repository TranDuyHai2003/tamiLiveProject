# Copy thành .env rồi chỉnh: cp .env.example .env
# Giá trị dưới đây khớp với docker-compose.yml (môi trường DEV). Không dùng cho staging/production.

# development | staging | production. Production tắt trang /docs (Swagger UI).
APP_ENV=development

# Địa chỉ HTTP server lắng nghe
HTTP_ADDR=:8080

# Postgres của docker-compose (cổng 5440). DB dev: livestream
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/livestream?sslmode=disable

# DB riêng cho test tích hợp. Tên BẮT BUỘC kết thúc bằng _test: test sẽ xóa sạch dữ liệu ở đây.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5440/livestream_test?sslmode=disable

# Redis của docker-compose (cổng 6390), dùng cho chat Pub/Sub
REDIS_ADDR=localhost:6390
REDIS_PASSWORD=

# Ký access token (JWT HS256). Bắt buộc, tối thiểu 32 ký tự. Sinh bằng: openssl rand -hex 32
JWT_SECRET=
# Hạn access token
JWT_TTL=24h

# Phải khớp cặp key/secret trong docker/livekit/livekit.yaml
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev_livekit_secret_change_me_0123456789

# Secret chung với game provider để ký kết quả game (HMAC). Sinh bằng: openssl rand -hex 32
MINIGAME_HMAC_SECRET=

# % giá trị COIN của quà quy thành GEM cho host (0-100)
GIFT_GEM_RATE_PERCENT=50
