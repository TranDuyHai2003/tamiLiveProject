# Copy thành .env.local: cp .env.example .env.local
# Biến NEXT_PUBLIC_* được đóng cứng vào code lúc build (gửi xuống trình duyệt), không chứa secret.

# Địa chỉ backend Go (livestream-backend). Phải có trong CORS_ALLOWED_ORIGINS của backend là origin của web này.
NEXT_PUBLIC_API_URL=http://localhost:8080
